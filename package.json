{
  "name": "xiaojd-desktop",
  "private": true,
  "version": "0.3.0",
  "description": "小决定 Desktop",
  "author": "小决定 Desktop",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/scheduler.test.cjs",
    "test:countdown": "node tests/countdown-unit.cjs",
    "test:ui": "node tests/ui.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:1420 && electron .\"",
    "electron:pack": "npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "electron:build": "npm run electron:pack",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "cn.xiaojueding.desktop",
    "productName": "小决定 Desktop",
    "directories": {
      "output": "release/v0.3.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小决定 Desktop"
    }
  }
}
